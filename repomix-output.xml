@import "tailwindcss";

@theme {
  --color-pigment-magenta: #ef476f;
  --color-pigment-pink: #ef1678;
  --color-pigment-orange: #ff761c;
  --color-pigment-yellow: #ffc21c;
  --color-pigment-red: #d91818;
  --color-signal: #ffc21c;
  --color-ink: #f8fafc;
  --color-foreground: #0f172a;
  --color-background: #f8fafc;
  --font-family-devanagari: 'Noto Sans Devanagari', sans-serif;
}

:root {
  /* Dark theme as default */
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-card: #1e293b;
  --text-primary: #f8fafc;
  --text-secondary: #cbd5e1;
  --border-color: #334155;
  --accent-color: #ef476f;

  /* Backwards compatible aliases used across the codebase */
  --accent: var(--accent-color);
  --border: var(--border-color);
  --text-h: var(--text-primary);
  --social-bg: rgba(255, 255, 255, 0.03);
  --shadow: 0 6px 20px rgba(2, 6, 23, 0.6);
  --accent-bg: rgba(239, 34, 120, 0.06);
  --accent-border: rgba(239, 34, 120, 0.18);

  /* Colour used for text displayed on bright accent backgrounds (e.g. pigment yellow) */
  --on-accent: #0f172a;

  /* RGB fallbacks for opacity helpers */
  --text-primary-rgb: 248, 250, 252;
  --text-secondary-rgb: 148, 163, 184;
  --bg-primary-rgb: 15, 23, 42;
  --bg-card-rgb: 30, 41, 59;
  --border-rgb: 51, 65, 85;

  /* ── Hero section theme variables ── */
  --hero-bg: #0b1120;
  --hero-text: #f8fafc;
  --hero-tagline: #ffc21c;
  --hero-body: rgba(226, 232, 240, 0.75);
  --hero-scroll: rgba(203, 213, 225, 0.9);

  /* Gradient background layers */
  --hero-gradient: radial-gradient(circle at 72% 38%,
      rgba(239, 22, 120, 0.24) 0%,
      transparent 32%),
    radial-gradient(circle at 88% 72%,
      rgba(255, 194, 28, 0.18) 0%,
      transparent 30%),
    linear-gradient(115deg, #050816 0%, #0f172a 45%, #111827 100%);

  /* Glowing orbs */
  --hero-orb-pink: rgba(239, 22, 120, 0.3);
  --hero-orb-orange: rgba(255, 118, 28, 0.3);
  --hero-orb-red: rgba(217, 24, 24, 0.28);
  --hero-orb-gold: rgba(255, 194, 28, 0.3);

  /* Vignette overlay */
  --hero-vignette: linear-gradient(90deg,
      rgba(2, 6, 23, 0.92) 0%,
      rgba(15, 23, 42, 0.72) 45%,
      rgba(15, 23, 42, 0.22) 78%),
    radial-gradient(circle at 72% 48%,
      transparent 0%,
      rgba(2, 6, 23, 0.2) 52%,
      rgba(2, 6, 23, 0.82) 100%);
}

html.light {
  --bg-primary: #ffffff;
  --bg-secondary: #f8fafc;
  --bg-card: #ffffff;
  --text-primary: #0f172a;
  --text-secondary: #1f2937;
  --border-color: #e6edf3;
  --accent-color: #2563eb;

  --accent: var(--accent-color);
  --border: var(--border-color);
  --text-h: var(--text-primary);
  --social-bg: rgba(15, 23, 42, 0.03);
  --shadow: 0 6px 20px rgba(2, 6, 23, 0.06);
  --accent-bg: rgba(37, 99, 235, 0.06);
  --accent-border: rgba(37, 99, 235, 0.18);

  --on-accent: #0f172a;

  /* RGB fallbacks for opacity helpers (light theme)
     Note: keep same variable names so helper classes work in both themes */
  --text-primary-rgb: 15, 23, 42;
  --text-secondary-rgb: 31, 41, 55;
  --bg-primary-rgb: 255, 255, 255;
  --bg-card-rgb: 255, 255, 255;
  --border-rgb: 230, 237, 243;

  /* ── Hero section – light theme overrides ── */
  --hero-bg: #fffaf5;
  --hero-text: #0f172a;
  --hero-tagline: #ef476f;
  --hero-body: rgba(15, 23, 42, 0.65);
  --hero-scroll: rgba(15, 23, 42, 0.7);

  --hero-gradient: radial-gradient(circle at 72% 38%,
      rgba(239, 22, 120, 0.12) 0%,
      transparent 32%),
    radial-gradient(circle at 88% 72%,
      rgba(255, 194, 28, 0.14) 0%,
      transparent 30%),
    linear-gradient(115deg, #ffffff 0%, #fff7ed 45%, #fff1f7 100%);

  --hero-orb-pink: rgba(239, 22, 120, 0.14);
  --hero-orb-orange: rgba(255, 118, 28, 0.14);
  --hero-orb-red: rgba(217, 24, 24, 0.12);
  --hero-orb-gold: rgba(255, 194, 28, 0.16);

  --hero-vignette: linear-gradient(90deg,
      rgba(255, 255, 255, 0.82) 0%,
      rgba(255, 247, 237, 0.52) 45%,
      rgba(255, 241, 247, 0.12) 78%),
    radial-gradient(circle at 72% 48%,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 52%,
      rgba(255, 255, 255, 0.48) 100%);
}

@layer base {
  html {
    scroll-behavior: smooth;
  }

  body {
    @apply m-0 overflow-x-clip antialiased;
    background: var(--bg-primary);
    color: var(--text-primary);
    transition: background-color 0.3s, color 0.3s;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  a {
    @apply no-underline text-inherit;
  }

  button,
  input,
  textarea {
    font: inherit;
  }


  #root {
    @apply min-h-screen overflow-x-clip;
  }

  ::selection {
    background: var(--accent-color);
    color: var(--bg-primary);
  }

  :focus-visible {
    box-shadow: 0 0 0 4px rgba(239, 34, 120, 0.12);
  }

  /* Header — always dark regardless of active theme */
  .site-header {
    background: color-mix(in srgb, #0f172a 90%, transparent);
    border-bottom: 1px solid rgba(51, 65, 85, 0.55);
    color: #f8fafc;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* Override inherited light-theme colors inside the header */
  .site-header,
  .site-header *,
  .site-header a,
  .site-header button {
    --text-primary: #f8fafc;
    --text-secondary: #cbd5e1;
    --border-color: #334155;
    --bg-card: #1e293b;
    --border: #334155;
    --accent-color: #ef476f;
  }

  .site-footer {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .mobile-nav {
    background: #1e293b;
    color: #f8fafc;
  }

  .skip-link {
    background: var(--bg-card);
    color: var(--text-primary);
  }

  html.light body {
    background:
      radial-gradient(circle at 12% 8%, rgba(239, 22, 120, 0.1), transparent 28%),
      radial-gradient(circle at 84% 18%, rgba(255, 194, 28, 0.16), transparent 30%),
      linear-gradient(120deg, #ffffff 0%, #fff7ed 48%, #fff1f7 100%);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Smooth color transitions for components */
* {
  transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
}

/* Map common Tailwind utility color classes to CSS variables so components adapt */
.bg-black {
  background-color: var(--bg-card) !important;
}

.text-white {
  color: var(--text-primary) !important;
}

.border-white {
  border-color: var(--border) !important;
}

.text-black {
  color: var(--text-primary) !important;
}

.bg-white {
  background-color: var(--bg-primary) !important;
}

.border-black {
  border-color: var(--border) !important;
}

/* Common opacity variants used in the codebase (escape slashes) */
.text-black\/40 {
  color: rgba(var(--text-primary-rgb), 0.4) !important;
}

.text-black\/45 {
  color: rgba(var(--text-primary-rgb), 0.45) !important;
}

.text-black\/70 {
  color: rgba(var(--text-primary-rgb), 0.7) !important;
}

.text-white\/55 {
  color: var(--text-secondary) !important;
}

.text-white\/65 {
  color: rgba(var(--text-primary-rgb), 0.78) !important;
}

.border-black\/15 {
  border-color: rgba(var(--border-rgb), 0.15) !important;
}

.text-black\/40 {
  color: rgba(var(--text-primary-rgb), 0.4) !important;
}

/* Semantic theme helpers */
.bg-primary {
  background-color: var(--bg-primary) !important;
}

html.light .bg-primary {
  background:
    radial-gradient(circle at 18% 0%, rgba(239, 22, 120, 0.1), transparent 30%),
    radial-gradient(circle at 82% 12%, rgba(255, 194, 28, 0.14), transparent 32%),
    linear-gradient(120deg, #ffffff 0%, #fff8ef 48%, #fff3f8 100%) !important;
}

.bg-secondary {
  background-color: var(--bg-secondary) !important;
}

html.light .bg-secondary {
  background:
    radial-gradient(circle at 14% 6%, rgba(239, 22, 120, 0.08), transparent 28%),
    radial-gradient(circle at 88% 20%, rgba(255, 194, 28, 0.12), transparent 30%),
    linear-gradient(120deg, #fffaf5 0%, #fff5eb 48%, #fff0f6 100%) !important;
}

.bg-card {
  background-color: var(--bg-card) !important;
}

html.light .bg-card {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 247, 237, 0.9) 52%, rgba(255, 242, 248, 0.92)) !important;
}

.text-primary {
  color: var(--text-primary) !important;
}

.text-secondary {
  color: var(--text-secondary) !important;
}

.border-theme {
  border-color: var(--border) !important;
}

.bg-accent {
  background-color: var(--accent-color) !important;
}

.text-accent {
  color: var(--accent-color) !important;
}

/* Text color for use on bright accent backgrounds (ensures readable contrast) */
.text-on-accent {
  color: var(--on-accent) !important;
}

@keyframes heroGradientShift {
  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

.hero-gradient-text {
  color: #ffd166;
  background-image: linear-gradient(90deg, #ef476f 0%, #f77f00 52%, #ffd166 100%);
  background-size: 200% auto;
  animation: heroGradientShift 4s linear infinite;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

@supports not (-webkit-background-clip: text) {
