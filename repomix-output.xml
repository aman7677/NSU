export default function Button({
  children,
  to,
  href,
  variant = "primary",
  icon = true,
  className = "",
  ...props
}) {
  const styles =
    variant === "primary"
      ? "bg-card text-primary border-theme hover:bg-pigment-magenta hover:border-pigment-magenta"
      : "border-theme bg-primary text-primary hover:border-pigment-orange hover:text-pigment-orange";
